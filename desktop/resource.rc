#define VS_VERSION_INFO 1

VS_VERSION_INFO VERSIONINFO
FILEVERSION 2,0,0,0
PRODUCTVERSION 2,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "GameMusick Project"
            VALUE "FileDescription", "GameMusick Interactive Telemetry Sensor"
            VALUE "FileVersion", "2.0.0.0"
            VALUE "InternalName", "interactive_sensor"
            VALUE "LegalCopyright", "Copyright (C) 2026 GameMusick. Open source MIT License."
            VALUE "OriginalFilename", "interactive_sensor.exe"
            VALUE "ProductName", "GameMusick Desktop"
            VALUE "ProductVersion", "2.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

1 24 "app.manifest"
